# Copy to .env and fill real values. All values below are dummies.
# Never commit a real .env — it is gitignored.
#
# .env is the single source for BOTH `docker compose up` (compose reads it
# for variable interpolation AND injects it into containers via env_file)
# and host-side npm scripts (export the vars yourself, or `set -a; . .env`).
# Inside the compose network the database host is the service name `db`;
# host-side commands that talk to Postgres directly need 127.0.0.1 instead.

# --- Postgres superuser (db service init + one-shot role bootstrap) ---
POSTGRES_DB=gwp
POSTGRES_USER=gwp
POSTGRES_PASSWORD=CHANGE_ME

# --- Least-privilege application roles (set by the db-bootstrap service) ---
GWP_MIGRATOR_PASSWORD=CHANGE_ME
GWP_RUNTIME_PASSWORD=CHANGE_ME
GWP_MAINTENANCE_PASSWORD=CHANGE_ME

# Superuser URL used ONLY by the db-bootstrap one-shot service.
BOOTSTRAP_ADMIN_URL=postgres://gwp:CHANGE_ME@db:5432/gwp

# PostgreSQL connection string for the API server (least-privilege runtime
# role). `db` resolves only inside the compose network.
DATABASE_URL=postgres://gwp_runtime:CHANGE_ME@db:5432/gwp

# Separate migrator credential with DDL rights, used ONLY by the one-shot
# `migrate` service and host-side `npm run db:migrate`. Required when
# NODE_ENV=production; dev may omit it (db:migrate falls back to
# DATABASE_URL). Roles are provisioned by scripts/ops/bootstrap-db-roles.ts;
# in production the operator sets role passwords via the secret store.
MIGRATOR_DATABASE_URL=postgres://gwp_migrator:CHANGE_ME@db:5432/gwp

# Read-only role for `npm run ops:backup` against the compose deployment.
BACKUP_DATABASE_URL=postgres://gwp_maintenance:CHANGE_ME@db:5432/gwp

# Secrets. Required; must be >= 32 chars when NODE_ENV=production.
# Generate with e.g. `openssl rand -hex 32`.
JWT_SECRET=dummy-jwt-secret-change-me-000000000000
APP_KEY=dummy-app-key-change-me-0000000000000000
BOOTSTRAP_TOKEN=dummy-bootstrap-token-change-me-000000

# Deployment mode: "demo" (allows demo seed) or "production". It is an
# immutable property of the database — the migrator records it in
# deployment_state and boot refuses a mismatch; never flip it on a live DB.
DEMO_MODE=production

# Public origin the app is served from (Origin checks + cookies). Must match
# exactly what browsers send — use the real https:// origin behind a
# reverse proxy; http://localhost:8080 works for local use.
APP_ORIGIN=http://localhost:8080

# Token TTLs in seconds (defaults shown). Access JWT: 10 minutes; refresh
# session absolute cap: 7 days. Refresh token travels only in the HttpOnly
# gwp_refresh cookie (Path=/api/v1/auth); gwp_csrf is the JS-readable CSRF
# mirror cookie echoed back as the X-CSRF-Token header on refresh/logout.
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800

# Container listen port (always 8080 in the image). APP_PORT is the host
# port compose publishes, on ALL interfaces — LAN access is intentional.
PORT=8080
APP_PORT=8080

# Express "trust proxy" setting: true | false | hop count | CIDR/loopback list.
TRUST_PROXY=false

# Test-only database (compose.test.yaml). Never point at a real database —
# tests create and drop per-file schemas here. TEST_DATABASE_URL is the
# least-privilege runtime role; the migrator credential runs migrations and
# the maintenance credential (superuser) creates/drops schemas and grants.
TEST_DATABASE_URL=postgres://gwp_runtime:gwp_runtime@127.0.0.1:54329/gwp_test
TEST_MIGRATOR_DATABASE_URL=postgres://gwp_migrator:gwp_migrator@127.0.0.1:54329/gwp_test
TEST_MAINTENANCE_DATABASE_URL=postgres://gwp_test:gwp_test@127.0.0.1:54329/gwp_test
