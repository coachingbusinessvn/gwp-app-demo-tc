# Copy to .env and fill real values. All values below are dummies.
# Never commit a real .env — it is gitignored.

# PostgreSQL connection string for the API server.
DATABASE_URL=postgres://gwp_app:gwp_app_password@127.0.0.1:5432/gwp

# Secrets. Required; must be >= 32 chars when NODE_ENV=production.
# Generate with e.g. `openssl rand -hex 32`.
JWT_SECRET=dummy-jwt-secret-change-me-000000000000
APP_KEY=dummy-app-key-change-me-0000000000000000
BOOTSTRAP_TOKEN=dummy-bootstrap-token-change-me-000000

# Deployment mode: "demo" (allows demo seed) or "production".
DEMO_MODE=production

# Public origin the app is served from (used for Origin checks / cookies).
APP_ORIGIN=https://app.example.test

# HTTP listen port. Default 8080.
PORT=8080

# Express "trust proxy" setting: true | false | hop count | CIDR/loopback list.
TRUST_PROXY=false

# Test-only database (compose.test.yaml). Never point at a real database —
# tests create and drop per-file schemas here.
TEST_DATABASE_URL=postgres://gwp_test:gwp_test@127.0.0.1:54329/gwp_test
