# Copy to .env and fill real values. All values below are dummies.
# Never commit a real .env — it is gitignored.

# PostgreSQL connection string for the API server (least-privilege runtime role).
DATABASE_URL=postgres://gwp_runtime:gwp_runtime_password@127.0.0.1:5432/gwp

# Separate migrator credential with DDL rights, used ONLY by `npm run db:migrate`.
# Required when NODE_ENV=production; dev may omit it (db:migrate falls back to
# DATABASE_URL). Roles are provisioned by scripts/ops/bootstrap-db-roles.ts;
# in production the operator sets role passwords via the secret store.
MIGRATOR_DATABASE_URL=postgres://gwp_migrator:gwp_migrator_password@127.0.0.1:5432/gwp

# Secrets. Required; must be >= 32 chars when NODE_ENV=production.
# Generate with e.g. `openssl rand -hex 32`.
JWT_SECRET=dummy-jwt-secret-change-me-000000000000
APP_KEY=dummy-app-key-change-me-0000000000000000
BOOTSTRAP_TOKEN=dummy-bootstrap-token-change-me-000000

# Deployment mode: "demo" (allows demo seed) or "production".
DEMO_MODE=production

# Public origin the app is served from (used for Origin checks / cookies).
APP_ORIGIN=https://app.example.test

# Token TTLs in seconds (defaults shown). Access JWT: 10 minutes; refresh
# session absolute cap: 7 days. Refresh token travels only in the HttpOnly
# gwp_refresh cookie (Path=/api/v1/auth); gwp_csrf is the JS-readable CSRF
# mirror cookie echoed back as the X-CSRF-Token header on refresh/logout.
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800

# HTTP listen port. Default 8080.
PORT=8080

# Express "trust proxy" setting: true | false | hop count | CIDR/loopback list.
TRUST_PROXY=false

# Test-only database (compose.test.yaml). Never point at a real database —
# tests create and drop per-file schemas here. TEST_DATABASE_URL is the
# least-privilege runtime role; the migrator credential runs migrations and
# the maintenance credential (superuser) creates/drops schemas and grants.
TEST_DATABASE_URL=postgres://gwp_runtime:gwp_runtime@127.0.0.1:54329/gwp_test
TEST_MIGRATOR_DATABASE_URL=postgres://gwp_migrator:gwp_migrator@127.0.0.1:54329/gwp_test
TEST_MAINTENANCE_DATABASE_URL=postgres://gwp_test:gwp_test@127.0.0.1:54329/gwp_test
